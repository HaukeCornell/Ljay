{
  "name": "ljay",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n sidecar,web -c blue,green \"npm:dev:sidecar\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:sidecar": "node sidecar/index.mjs",
    "build:helper": "swiftc -O sidecar/nowplaying_helper.swift -o sidecar/nowplaying_helper",
    "build": "tsc -b && vite build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "butterchurn": "^3.0.0-beta.4",
    "butterchurn-presets": "^3.0.0-beta.4",
    "preact": "^10.29.1",
    "three": "^0.170.0",
    "troika-three-text": "^0.52.4",
    "ws": "^8.18.0"
  }
}
